# Copy this file to .env and fill in your values.
# Only the provider you actually run needs a key.


# ── Which model decides the moves ────────────────────────────────────────────
# Values: openai | anthropic          (note the spelling: anthropic, not antropic)
# Overridden per run by: ./run.sh --provider anthropic
LLM_PROVIDER=openai


# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# Values, most capable first (prices are per 1M tokens, input/output):
#   gpt-5.6-sol      frontier tier, $5 / $30 — `gpt-5.6` is an alias for this
#   gpt-5.6-terra    balanced, the mini tier of this generation, $2 / $12
#   gpt-5.6-luna     cost-optimized for volume, $0.20 / $1.20 — cheapest here
#   gpt-5.4-mini     older generation; what this project has been running
# All three 5.6 models have a ~1.05M context window.
#
# The id is passed through unvalidated, so anything the Responses API accepts
# works and a wrong one fails on the first call with OpenAI's own error.
OPENAI_MODEL=gpt-5.4-mini


# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Values, most capable first:
#   claude-fable-5     most capable, slowest, most expensive
#   claude-opus-5      the default here
#   claude-opus-4-8    previous Opus
#   claude-sonnet-5    near-Opus quality, cheaper
#   claude-haiku-4-5   fastest and cheapest — the one to try if latency hurts
ANTHROPIC_MODEL=claude-opus-5


# ── Thinking effort (both providers) ─────────────────────────────────────────
# Values: low | medium | high | xhigh | max
# Overridden per run by: ./run.sh --effort medium
#
# Leave this unset unless you want to change it:
#   Claude  — defaults to `low`, chosen for speed in a live match
#   OpenAI  — the parameter is left off the request entirely, so the model's
#             own default applies and nothing about the current setup changes
#
# On Claude, thinking cannot be switched off above `high`, so xhigh and max
# turn it on and are much slower. That is a real trade rather than a free knob:
# a placement is worth nothing once the push it was answering has crossed the
# bridge. Start low and only raise it if the bot is losing on decisions.
#
# OpenAI also accepts `none` and `minimal`; they are not offered here because
# Claude rejects them and one shared vocabulary is more useful than two rungs.
# Support varies per model — an unsupported level fails on the first call.
#LLM_EFFORT=low
